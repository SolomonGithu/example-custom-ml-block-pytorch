{
    "version": 1,
    "type": "machine-learning",
    "info": {
        "name": "YOLO26",
        "description": "Object detection based on Ultralytics YOLO26 (square images only).",
        "operatesOn": "object_detection",
        "indRequiresGpu": false,
        "imageInputScaling": "0..1",
        "objectDetectionLastLayer": "yolov11-abs"
    },
    "parameters": [
        {
            "name": "Number of training cycles",
            "value": "30",
            "type": "int",
            "help": "Number of epochs to train for.",
            "param": "epochs"
        },
        {
            "name": "Model size",
            "value": "n",
            "type": "select",
            "valid": [
                {
                    "label": "Nano",
                    "value": "n"
                },
                {
                    "label": "Small",
                    "value": "s"
                },
                {
                    "label": "Medium",
                    "value": "m"
                }
            ],
            "param": "model-size"
        },
        {
            "name": "Batch size",
            "value": "16",
            "type": "int",
            "help": "Reduce this for larger models.",
            "param": "batch-size",
            "optional": true
        }
    ]
}